# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# Check your setup with: pnpm env:check
# Where to get each value: docs/SETUP.md

# Google AI Studio API key (embeddings + answer generation).
# Create it WITHOUT linking billing so the free tier cannot charge you.
GEMINI_API_KEY=

# Qdrant Cloud free cluster: URL from the cluster page, e.g.
# https://<cluster-id>.<region>.<provider>.cloud.qdrant.io:6333
QDRANT_URL=

# Qdrant Cloud API key for that cluster.
QDRANT_API_KEY=

# Qdrant collection name used by ingestion and retrieval.
QDRANT_COLLECTION=portfolio_knowledge
