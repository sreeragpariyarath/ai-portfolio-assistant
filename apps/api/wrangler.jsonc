/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The Worker name is part of the public address (<name>.<your-subdomain>.workers.dev). Renaming it after the first
	// deploy creates a new Worker, so settle it before then.
	"name": "sreerag",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "../web/out",
		"run_worker_first": ["/api/*"],
		"not_found_handling": "404-page"
	},
	/**
	 * Once a day, read the size of the Qdrant collection so the free cluster is not suspended (it is after a week
	 * of inactivity and deleted after four). Times are UTC. See src/keep-alive.ts.
	 */
	"triggers": {
		"crons": ["23 4 * * *"]
	},
	/**
	 * Non-secret settings. Safe to commit; never put keys or URLs with credentials here.
	 * GEMINI_MODEL, GEMINI_FALLBACK_MODEL and EMBEDDING_MODEL can change without a code change (see D-012, D-015, D-016).
	 * ALLOWED_ORIGIN lists the origins that may call /api/chat from a browser, separated by spaces: the live site
	 * (same address as the API, so CORS rarely applies there) and the local web app (`pnpm dev:web` calling `wrangler dev`).
	 */
	"vars": {
		"QDRANT_COLLECTION": "portfolio_knowledge",
		"GEMINI_MODEL": "gemini-3.1-flash-lite",
		"GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
		"EMBEDDING_MODEL": "gemini-embedding-2",
		"ALLOWED_ORIGIN": "https://sreerag.pariyarath.workers.dev http://localhost:3000"
	},
	/**
	 * Required secrets. Local values go in apps/api/.dev.vars (git-ignored); deployed values are set with
	 * `wrangler secret put <NAME>`. Declaring them here types them in `Env` without needing a .dev.vars file
	 * (so CI can run `wrangler types`), loads only these keys locally, and makes `wrangler deploy` fail if one is missing.
	 */
	"secrets": {
		"required": ["GEMINI_API_KEY", "QDRANT_URL", "QDRANT_API_KEY"]
	},
	/**
	 * Per-client limit for POST /api/chat (task 3.8, D-015): 10 requests per 60 seconds, keyed by client IP.
	 * Counts are approximate and per Cloudflare location. Whether the binding is available on the Workers
	 * Free plan is not stated in the docs: check at the first deploy (Phase 5). Without the binding the Worker
	 * falls back to an in-memory counter (see src/rate-limit.ts).
	 */
	"ratelimits": [
		{
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}