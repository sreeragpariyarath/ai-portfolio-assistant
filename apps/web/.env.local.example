# Copy to apps/web/.env.local (git-ignored) for local development. No secret goes here:
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time.
#
# Local development: the web app (port 3000) calls the API Worker (pnpm dev:api, port 8787).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
#
# Production build: leave it unset or empty. One Worker serves the web files and /api/*,
# so the browser calls the same-origin path /api/chat (D-020).
