{
  "name": "ai-portfolio-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "test:web:a11y": "playwright test",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "eval:validate": "node --disable-warning=ExperimentalWarning scripts/validate-eval.ts",
    "eval:baseline": "node --disable-warning=ExperimentalWarning scripts/retrieval-baseline.ts",
    "eval:retrieval": "node --disable-warning=ExperimentalWarning scripts/retrieval-eval.ts",
    "eval:answers": "node --disable-warning=ExperimentalWarning scripts/answer-eval.ts",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "test:scripts": "node --disable-warning=ExperimentalWarning --test \"scripts/**/*.test.ts\" \"packages/rag/test/**/*.test.ts\" \"apps/web/src/**/*.test.ts\"",
    "web:size": "node --disable-warning=ExperimentalWarning scripts/web-size.ts",
    "corpus:build": "node --disable-warning=ExperimentalWarning scripts/build-corpus.ts",
    "corpus:check": "node --disable-warning=ExperimentalWarning scripts/build-corpus.ts --check",
    "env:check": "node --disable-warning=ExperimentalWarning scripts/check-env.ts",
    "ingest": "node --disable-warning=ExperimentalWarning scripts/ingest/ingest-qdrant.ts",
    "ingest:dry": "node --disable-warning=ExperimentalWarning scripts/ingest/ingest-qdrant.ts --dry-run",
    "qdrant:query": "node --disable-warning=ExperimentalWarning scripts/qdrant-query.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@portfolio/rag": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
